{
  "name": "@trade-tycoon/server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:game-logic --prefix ../.. && tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "npm run build:game-logic --prefix ../.. && vitest run src --no-file-parallelism",
    "test:coverage": "npm run build:game-logic --prefix ../.. && vitest run src --no-file-parallelism --coverage"
  },
  "dependencies": {
    "@trade-tycoon/game-logic": "*",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
