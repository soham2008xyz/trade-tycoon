{
  "name": "@trade-tycoon/client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:web",
    "build:web": "expo export --platform web",
    "generate:pwa": "node ./scripts/generate-pwa-assets.js && node ./scripts/generate-sw.js",
    "vercel-build": "npm run build:web && npm run generate:pwa",
    "serve:dist": "npm run build && serve ./dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-community/slider": "5.2.0",
    "@trade-tycoon/game-logic": "^1.0.0",
    "expo": "^57.0.23",
    "expo-build-properties": "~57.0.20",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.2",
    "serve": "^14.2.5",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "workbox-build": "^7.4.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
