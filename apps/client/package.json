{
  "name": "@trade-tycoon/client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "npm run build:game-logic --prefix ../.. && expo lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:web",
    "build:web": "expo export --platform web",
    "generate:og": "node ./scripts/generate-og-image.js",
    "generate:pwa": "node ./scripts/generate-pwa-assets.js && node ./scripts/generate-sw.js",
    "vercel-build": "npm run build:web && npm run generate:pwa",
    "serve:dist": "npm run build && serve ./dist",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-community/slider": "5.2.1",
    "@trade-tycoon/game-logic": "^1.0.0",
    "expo": "^58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~58.0.4",
    "serve": "^14.2.5",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "react-native-reanimated"
      ]
    }
  },
  "private": true
}
