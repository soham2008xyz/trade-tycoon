# Trade Tycoon — repo-root environment variables for local tooling.
# Copy to `.env` (gitignored) and fill in. Server runtime vars live in
# apps/server/.env.example instead.

# Render API key for the Render MCP server configured in .mcp.json.
# `.mcp.json` loads this file via `npx dotenv-cli` so the key never has to be
# committed. Create one under Account Settings → API Keys in the Render
# Dashboard: https://render.com/docs/mcp-server
RENDER_API_KEY=

# The Vercel MCP server in .mcp.json (https://mcp.vercel.com) needs no entry
# here: it authenticates with OAuth, not an API key. Run `/mcp` in Claude Code
# and pick "vercel" to sign in. Don't add a VERCEL_TOKEN for it — the endpoint
# only accepts the OAuth flow from Vercel-approved clients.
# https://vercel.com/docs/agent-resources/vercel-mcp

# Codacy account API token for the Codacy MCP server configured in .mcp.json.
# Loaded the same way as RENDER_API_KEY (via `npx dotenv-cli`). Create one under
# Codacy → Account → Access management → Account API tokens:
# https://docs.codacy.com/codacy-api/api-tokens/
CODACY_ACCOUNT_TOKEN=
